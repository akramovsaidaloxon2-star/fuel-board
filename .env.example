# Local development: copy this file to ".env" and fill in real values.
# On the cloud host (Render), DO NOT use a .env file — set these as
# environment variables in the dashboard instead.

# Your Motive API key (kept secret, never committed):
MOTIVE_API_KEY=your-motive-api-key-here

# Port (local only; Render sets this automatically):
PORT=3000

# Login for the board. Leave both empty for no login (local).
# Set both on the cloud host to require a username + password:
AUTH_USER=admin
AUTH_PASS=change-me-to-a-strong-password

# Random secret used to sign login session cookies. Set an explicit strong
# value on the cloud host (falls back to a value derived from the passwords
# above if left unset, which is weaker):
SESSION_SECRET=set-a-long-random-string-here

# Token for the public, login-free /api/toll.csv share link (Google Sheets
# =IMPORTDATA). If unset, a random key is generated at startup and printed
# to the logs once -- copy it here (or set your own) so the link doesn't
# change on every restart/redeploy:
TOLL_CSV_KEY=set-a-long-random-string-here
