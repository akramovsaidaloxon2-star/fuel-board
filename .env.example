# Local development: copy this file to ".env" and fill in real values.
# On the cloud host (Render), DO NOT use a .env file — set these as
# environment variables in the dashboard instead.

# Your Motive API key (kept secret, never committed):
MOTIVE_API_KEY=your-motive-api-key-here

# Port (local only; Render sets this automatically):
PORT=3000

# Login for the board. Leave both empty for no login (local).
# Set both on the cloud host to require a username + password:
AUTH_USER=admin
AUTH_PASS=change-me-to-a-strong-password

# --- Operations seat (toll directions, on trial) ---
# A separate login that sees everything the manager does PLUS the Directions
# tab. Leave both empty and the tab, the API and the reminders stay switched
# off entirely — the manager board is then exactly as it was.
OPS_USER=
OPS_PASS=

# Dispatch Google Sheet holding the directions. READ ONLY — nothing is ever
# written back. Two accepted forms:
#   1. File > Share > Publish to web > CSV  ->  .../pub?gid=0&single=true&output=csv
#   2. The normal /edit link, IF the sheet is shared "anyone with the link can view"
TOLL_SHEET_CSV=

# How often a still-unconfirmed direction is re-announced, in minutes (default 30):
REMIND_EVERY_MIN=30
# How often the sheet is re-read, in minutes (default 3):
SHEET_POLL_MIN=3

# NOTE: direction reminders reuse the existing TELEGRAM_BOT_TOKEN /
# TELEGRAM_CHAT_ID above — there is no second bot to set up.
